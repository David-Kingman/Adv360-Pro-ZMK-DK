#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        as_ht: autoshift_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "AUTOSHIFT_HOLD_TAP";
            bindings = <&shift>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            flavor = "tap-preferred";
        };

        auto_control: auto_control_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "AUTO_CONTROL_HOLD_TAP";
            bindings = <&control>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            flavor = "tap-preferred";
        };
    };

    combos {
        compatible = "zmk,combos";

        mouse_toggle {
            bindings = <&tog 1>;
            key-positions = <65 70>;
        };
    };

    macros {
        as: as {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>;

            label = "AS";
        };

        shift: shift {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_tap>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LEFT_SHIFT>;

            label = "SHIFT";
        };

        control: control {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL>,
                <&macro_tap>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LEFT_CONTROL>;

            label = "CONTROL";
        };

        ac: ac {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &macro_param_1to2 &auto_control MACRO_PLACEHOLDER MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &macro_param_1to2 &auto_control MACRO_PLACEHOLDER MACRO_PLACEHOLDER>;

            label = "AC";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL         &kp N1          &kp N2          &kp N3       &kp N4            &kp N5  &tog 0                                                            &mo 0      &kp N6  &kp N7             &kp N8               &kp N9           &kp N0              &kp MINUS
&kp TAB           &kp Q           &kp W           &kp E        &kp R             &kp T   &none                                                             &none      &kp Y   &kp U              &kp I                &kp O            &kp P               &kp BSLH
&kp ESC           &hm LEFT_GUI A  &hm LEFT_ALT S  &hm LCTRL D  &hm LEFT_SHIFT F  &kp G   &kp TAB   &mo 0    &kp LALT           &kp C_VOLUME_UP  &mo 0      &none      &kp H   &hm RIGHT_SHIFT J  &hm RIGHT_CONTROL K  &hm RIGHT_ALT L  &hm RIGHT_GUI SEMI  &kp SQT
&kp LSHFT         &kp Z           &kp X           &kp C        &kp V             &kp B                      &kp RG(RS(S))      &kp C_VOL_DN                           &kp N   &kp M              &kp COMMA            &kp DOT          &kp FSLH            &kp RSHFT
&kp LEFT_CONTROL  &kp GRAVE       &kp CAPS        &kp LEFT     &kp RIGHT                 &kp BSPC  &kp DEL  &kp LA(F4)         &kp C_MUTE       &kp ENTER  &kp SPACE          &kp UP             &kp DOWN             &kp LBKT         &kp RBKT            &kp RIGHT_CONTROL
            >;
        };

        navigation {
            bindings = <
&none  &none  &none           &none           &none            &none  &none                                  &none  &none  &none           &none           &none            &none  &none
&none  &none  &kp TAB         &mkp MB4        &mkp MB5         &none  &none                                  &none  &none  &kp PAGE_UP     &kp PAGE_DOWN   &none            &none  &none
&none  &none  &msc SCRL_DOWN  &mkp LCLK       &mkp RCLK        &none  &none  &none  &none      &none  &none  &none  &none  &mmv MOVE_LEFT  &mmv MOVE_UP    &mmv MOVE_RIGHT  &none  &none
&none  &none  &msc SCRL_UP    &msc SCRL_LEFT  &msc SCRL_RIGHT  &none                &none      &none                &none  &kp RIGHT_ALT   &mmv MOVE_DOWN  &none            &none  &none
&none  &none  &none           &none           &none                   &none  &none  &none      &none  &none  &none         &none           &none           &none            &none  &none
            >;
        };
    };
};
